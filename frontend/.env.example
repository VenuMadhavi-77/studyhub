# ==============================================================================
# STUDYHUB FRONTEND - VITE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development, or set these variables
# in your Vercel / Netlify / CI environment dashboard.

# ------------------------------------------------------------------------------
# 1. Backend API Base URL
# ------------------------------------------------------------------------------
# Docker Compose / Local Nginx proxy (default - leave as-is for docker-compose up):
VITE_API_URL=/api/v1

# External backend (Vercel / Netlify frontend + separate backend deployment):
# VITE_API_URL=https://api.studyhub.edu/api/v1

# Local development without Nginx proxy (proxied by Vite dev server - not needed):
# VITE_API_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------------------------
# 2. Demo Login Button Visibility
# ------------------------------------------------------------------------------
# Set to true to show 1-click demo credential buttons on the login page.
# Enabled automatically in Vite DEV mode (import.meta.env.DEV = true).
VITE_SHOW_DEMO_LOGIN=false
