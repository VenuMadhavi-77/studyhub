# StudyHub Backend Environment Variables Template
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Database Configuration (Local MySQL / Docker)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studyhub_db
DB_USERNAME=root
DB_PASSWORD=password
DB_SSL_MODE=DISABLED

# Production Database (Aiven MySQL)
# DB_HOST=mysql-studyhub-org.aivencloud.com
# DB_PORT=24950
# DB_NAME=defaultdb
# DB_USERNAME=avnadmin
# DB_PASSWORD=your_aiven_password_here
# DB_SSL_MODE=REQUIRED

# Security & JWT (Generate a 256-bit base64 secret)
JWT_SECRET=dGhpc2lzYXZlcnlzZWNyZXRrZXlmb3JzdHVkeWh1YmFwcGxpY2F0aW9uMjAyNmJ5c3ByaW5nYm9vdDM=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Admin Bootstrap Credentials
ADMIN_BOOTSTRAP_EMAIL=admin@studyhub.edu
ADMIN_BOOTSTRAP_PASSWORD=AdminStudyHub#2026
ADMIN_BOOTSTRAP_NAME=System Administrator

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage Configuration (LOCAL or S3)
STORAGE_TYPE=LOCAL
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE_MB=25

# AI Provider Configuration (GEMINI, OPENAI, CLAUDE)
AI_PROVIDER=GEMINI
AI_API_KEY=your_gemini_api_key_here
AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_QUOTA=50
AI_TIMEOUT_SECONDS=15

# Frontend Build Variables
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080/ws-studyhub
